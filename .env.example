# ─────────────────────────────────────────────────────────────
#  EstudIA · variables de entorno
#  Copia este fichero como `.env` y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos. SQLite por defecto (no requiere instalar nada).
# En produccion puedes usar PostgreSQL cambiando tambien el `provider`
# del datasource en prisma/schema.prisma:
#   DATABASE_URL="postgresql://user:pass@host:5432/estudia"
DATABASE_URL="file:./dev.db"

# Secreto para firmar las cookies de sesion (JWT). OBLIGATORIO en produccion.
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ── IA (resumen + esquema + adaptacion a voz) ────────────────
# Sin esta clave la aplicacion sigue funcionando en "modo sin IA":
# genera un resumen y un esquema extractivos a partir del propio PDF
# (sin inventar nada), pero la calidad es notablemente menor.
# Consiguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Modelo usado para el analisis por fragmentos y la sintesis global.
AI_MODEL="claude-opus-5"
# Modelo usado en el nivel "Muy detallado". Si quieres abaratar el procesado de
# documentos largos, puedes poner aqui (o en AI_MODEL) "claude-sonnet-5".
AI_MODEL_DEEP="claude-opus-5"

# ── Text-to-Speech ───────────────────────────────────────────
# Proveedor de voz del servidor: "none" | "openai" | "elevenlabs"
# Con "none" la app usa la voz del propio dispositivo (Web Speech API):
# funciona sin claves, pero no permite reproduccion en segundo plano.
TTS_PROVIDER="none"

# OpenAI TTS (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="alloy"

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
ELEVENLABS_MODEL="eleven_multilingual_v2"

# ── Almacenamiento de PDFs y audio ───────────────────────────
# "local" guarda los ficheros fuera de /public (nunca son accesibles
# directamente por URL: se sirven mediante rutas autenticadas).
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# ── Limites de subida ────────────────────────────────────────
MAX_UPLOAD_MB="50"
MAX_PDF_PAGES="1200"
