# ─────────────────────────────────────────────────────────────
#  EstudIA · variables de entorno
#  Copia este fichero como `.env` y rellena los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos. SQLite por defecto (no requiere instalar nada).
# En produccion puedes usar PostgreSQL cambiando tambien el `provider`
# del datasource en prisma/schema.prisma:
#   DATABASE_URL="postgresql://user:pass@host:5432/estudia"
DATABASE_URL="file:./dev.db"
# El motor (SQLite o PostgreSQL) se deduce de esta URL: no hay que tocar el
# esquema de Prisma. Lo hace scripts/prisma-schema.mjs antes de cada comando.

# Secreto para firmar las cookies de sesion (JWT). OBLIGATORIO en produccion.
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ── IA (resumen + esquema + adaptacion a voz) ────────────────
# Sin esta clave la aplicacion sigue funcionando en "modo sin IA":
# genera un resumen y un esquema extractivos a partir del propio PDF
# (sin inventar nada), pero la calidad es notablemente menor.
# Consiguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Modelo usado para el analisis por fragmentos y la sintesis global.
AI_MODEL="claude-opus-5"
# Modelo usado en el nivel "Muy detallado". Si quieres abaratar el procesado de
# documentos largos, puedes poner aqui (o en AI_MODEL) "claude-sonnet-5".
AI_MODEL_DEEP="claude-opus-5"
# Fragmentos analizados en paralelo. Con 4, un temario de 400 paginas tarda
# unos minutos en lugar de media hora. Subelo si tu cuenta admite mas ritmo.
AI_CONCURRENCY="4"

# ── Text-to-Speech ───────────────────────────────────────────
# Proveedor de voz del servidor: "none" | "openai" | "elevenlabs"
# Con "none" la app usa la voz del propio dispositivo (Web Speech API):
# funciona sin claves, pero no permite reproduccion en segundo plano.
TTS_PROVIDER="none"

# OpenAI TTS (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="alloy"

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
ELEVENLABS_MODEL="eleven_multilingual_v2"

# ── OCR de paginas escaneadas ────────────────────────────────
# Funciona SIN ninguna clave: `npm install` trae el motor local (tesseract.js)
# y los datos del espanol. Valores: "tesseract" (local), "anthropic" (vision,
# mejor con escaneos malos o manuscritos, consume una llamada por pagina) o
# "none" para desactivarlo. Si no se indica nada, se usa el local cuando esta
# disponible y si no la vision.
OCR_PROVIDER=""
# Idiomas del motor local, separados por "+" (por ejemplo "spa+eng").
OCR_LANGS="spa"
# Carpeta con los ficheros <idioma>.traineddata.gz, si los tienes aparte.
OCR_LANG_PATH=""
# Paginas reconocidas en paralelo. Por defecto, tantas como nucleos (maximo 4)
# con el motor local y 3 con el de vision.
OCR_CONCURRENCY=""
# Resolucion del rasterizado antes de reconocer. 1.6 por defecto: da el mismo
# texto que 2 y tarda menos. Subelo si el escaneo es muy pobre.
OCR_SCALE="1.6"

# ── Almacenamiento de PDFs y audio ───────────────────────────
# "local" guarda los ficheros fuera de /public (nunca son accesibles
# directamente por URL: se sirven mediante rutas autenticadas).
# "s3" guarda en cualquier servicio compatible con S3 (Cloudflare R2,
# Supabase, Backblaze B2, MinIO...). Es lo que hace falta para publicarla en un
# alojamiento gratuito, porque ninguno da disco que sobreviva a los reinicios.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Solo con STORAGE_DRIVER="s3". Las credenciales viven unicamente en el
# servidor: nunca llegan al navegador.
#   R2:       https://<id-de-cuenta>.r2.cloudflarestorage.com
#   Supabase: https://<referencia>.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=""
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# ── Limites de subida ────────────────────────────────────────
MAX_UPLOAD_MB="80"
MAX_PDF_PAGES="1500"
# Tope de paginas a las que se aplica OCR en un mismo documento. Un libro
# escaneado entero consume una llamada de vision por pagina.
OCR_MAX_PAGES="600"
