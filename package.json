{
  "name": "estudia-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de estudio que convierte PDFs academicos en resumenes, esquemas y audiolibros.",
  "scripts": {
    "dev": "node scripts/ocr-navegador.mjs && next dev",
    "build": "node scripts/db-setup.mjs && node scripts/ocr-navegador.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "npm run db:schema && prisma db push --schema=prisma/schema.runtime.prisma",
    "db:generate": "npm run db:schema && prisma generate --schema=prisma/schema.runtime.prisma",
    "db:studio": "npm run db:schema && prisma studio --schema=prisma/schema.runtime.prisma",
    "postinstall": "node scripts/prisma-schema.mjs && prisma generate --schema=prisma/schema.runtime.prisma",
    "test:smoke": "node scripts/smoke-test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "demo": "node scripts/demo.mjs",
    "test:estructura": "tsx tests/unit/estructura.mts",
    "test:demo": "node tests/demo/run.mjs",
    "demo:assets": "node scripts/build-demo-assets.mjs",
    "test:instalable": "node tests/demo/instalable.mjs",
    "db:schema": "node scripts/prisma-schema.mjs",
    "test:almacenamiento": "tsx tests/unit/almacenamiento.mts",
    "test:reanudar": "tsx tests/unit/reanudar-ocr.mts",
    "test:rebanadas": "node tests/unit/rebanadas.mjs",
    "test:blob": "tsx tests/unit/blob.mts",
    "material": "node scripts/material.mjs",
    "test:almacen-db": "tsx tests/unit/almacen-db.mts",
    "test:db-url": "tsx tests/unit/db-url.mts",
    "test:vercel": "node scripts/prueba-vercel.mjs",
    "test:recorrido": "node tests/e2e/recorrido.mjs",
    "test:aislamiento": "node tests/e2e/aislamiento.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^16.3.5",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws4": "^1.13.2",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tesseract.js-data/spa": "^1.0.0",
    "tesseract.js": "^7.0.0"
  }
}
